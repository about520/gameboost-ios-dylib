# 强制所有文本文件用 LF。
# Windows 上 git 默认 autocrlf 会把 .sh 转成 CRLF，
# 到了 GitHub Actions 的 macOS runner 上会直接报
#   ./build_dylib.sh: /bin/bash^M: bad interpreter
# 所以这里必须显式锁定。

* text=auto eol=lf

*.sh        text eol=lf
*.m         text eol=lf
*.h         text eol=lf
*.py        text eol=lf
*.js        text eol=lf
*.json      text eol=lf
*.yml       text eol=lf
*.yaml      text eol=lf
*.md        text eol=lf
Makefile    text eol=lf
control     text eol=lf

# 二进制产物不做行尾转换
*.dylib     binary
*.ipa       binary
*.deb       binary
*.png       binary
